{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ClipSync AI",
  "version": "1.0.0",
  "identifier": "com.clipsync.ai.desktop",
  "build": {
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "ClipSync AI",
        "width": 1400,
        "height": 900,
        "resizable": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"]
  }
}
